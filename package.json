{
  "name": "rift-fishing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:basic": "tsc --noEmit && vite build --mode crazygames-basic --outDir dist-crazygames-basic",
    "build:full": "tsc --noEmit && vite build --mode crazygames-full --outDir dist-crazygames-full",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "vite-node scripts/simulate-economy.ts",
    "build:qa": "vite build --mode qa --outDir dist-qa",
    "package:basic": "npm run build:basic && cd dist-crazygames-basic && zip -qr ../rift-fishing-crazygames-basic.zip . && cd .. && echo rift-fishing-crazygames-basic.zip",
    "build:single": "vite build && node scripts/single-file.mjs dist rift-fishing-single.html"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-node": "3.2.4",
    "vitest": "3.2.7"
  }
}
